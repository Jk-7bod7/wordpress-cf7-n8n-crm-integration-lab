# =================================================================
# PORTFOLIO-024: Environment Configuration Example
# Copy this file to .env before starting the stack with Docker Compose
# =================================================================

# Database Configuration (MariaDB)
DB_NAME=wordpress_db
DB_USER=wp_user
DB_PASSWORD=wp_secure_pass_2026
DB_ROOT_PASSWORD=root_secure_pass_2026

# n8n Automation Engine
N8N_ENCRYPTION_KEY=n8n_lab_encryption_key_2026_change_me
WEBHOOK_SECRET=cf7_lab_secret_token_12345

# Mock CRM Configuration
CRM_API_URL=http://mock-crm:8000
CRM_DATABASE_PATH=/app/data/crm_leads.sqlite3

# Local Service Port Bindings (Bound to 127.0.0.1 for local safety)
WP_PORT=8080
N8N_PORT=5678
CRM_PORT=8000
MAILPIT_UI_PORT=8025
MAILPIT_SMTP_PORT=1025
